### Auto Forms API Test
### Base URL - Update this to match your local environment
@baseUrl = http://localhost:8000
@contentType = application/json
@apiKey = your-secret-api-key-here

### ============================================
### Test 1: Basic Form with Common Field Types (POST)
### ============================================
POST {{baseUrl}}/auto-forms
Content-Type: {{contentType}}
X-API-Key: {{apiKey}}

{
  "fields": [
    {
      "name": "email",
      "type": "email",
      "label": "Email Address",
      "id": "email-field",
      "class": "form-control",
      "placeholder": "Enter your email",
      "value": ""
    },
    {
      "name": "password",
      "type": "password",
      "label": "Password",
      "id": "password-field",
      "class": "form-control",
      "placeholder": "Enter your password",
      "value": null
    },
    {
      "name": "full_name",
      "type": "text",
      "label": "Full Name",
      "id": "name-field",
      "class": "form-control",
      "placeholder": "Enter your full name",
      "value": ""
    }
  ]
}

### ============================================
### Test 2: Form with All Field Types
### ============================================
POST {{baseUrl}}/auto-forms
Content-Type: {{contentType}}
X-API-Key: {{apiKey}}

{
  "fields": [
    {
      "name": "email",
      "type": "email",
      "label": "Email",
      "id": "email",
      "class": "form-control",
      "placeholder": "example@email.com",
      "value": ""
    },
    {
      "name": "phone",
      "type": "tel",
      "label": "Phone Number",
      "id": "phone",
      "class": "form-control",
      "placeholder": "+1 234 567 8900",
      "value": ""
    },
    {
      "name": "website",
      "type": "url",
      "label": "Website",
      "id": "website",
      "class": "form-control",
      "placeholder": "https://example.com",
      "value": ""
    },
    {
      "name": "age",
      "type": "number",
      "label": "Age",
      "id": "age",
      "class": "form-control",
      "placeholder": "Enter your age",
      "value": ""
    },
    {
      "name": "birth_date",
      "type": "date",
      "label": "Birth Date",
      "id": "birth_date",
      "class": "form-control",
      "placeholder": "",
      "value": ""
    },
    {
      "name": "appointment",
      "type": "datetime-local",
      "label": "Appointment Time",
      "id": "appointment",
      "class": "form-control",
      "placeholder": "",
      "value": ""
    },
    {
      "name": "favorite_color",
      "type": "color",
      "label": "Favorite Color",
      "id": "color",
      "class": "form-control",
      "placeholder": "",
      "value": "#000000"
    },
    {
      "name": "volume",
      "type": "range",
      "label": "Volume",
      "id": "volume",
      "class": "form-control",
      "placeholder": "",
      "value": "50"
    },
    {
      "name": "newsletter",
      "type": "checkbox",
      "label": "Subscribe to Newsletter",
      "id": "newsletter",
      "class": "form-check-input",
      "placeholder": "",
      "value": ""
    },
    {
      "name": "gender",
      "type": "radio",
      "label": "Gender",
      "id": "gender",
      "class": "form-check-input",
      "placeholder": "",
      "value": "",
      "options": ["Male", "Female", "Other"]
    },
    {
      "name": "country",
      "type": "select",
      "label": "Country",
      "id": "country",
      "class": "form-control",
      "placeholder": "",
      "value": "",
      "options": ["USA", "Canada", "UK", "Germany", "France", "Japan"]
    },
    {
      "name": "message",
      "type": "textarea",
      "label": "Message",
      "id": "message",
      "class": "form-control",
      "placeholder": "Enter your message",
      "value": ""
    },
    {
      "name": "search",
      "type": "search",
      "label": "Search",
      "id": "search",
      "class": "form-control",
      "placeholder": "Search...",
      "value": ""
    }
  ]
}

